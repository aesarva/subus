  "components": [
    {
      "name": "Station Ring",
      "kind": "custom",
      "refersTo": "station-ring",
      "description": "Hollow 13 pt ring, 3 pt stroke in the category line colour; lifts to 16 pt with a 1 pt ink halo, recedes to 9 pt at 1.5 pt.",
      "html": "<span class=\"ds-station\"></span><span class=\"ds-station ds-station-lifted\"></span><span class=\"ds-station ds-station-receded\"></span>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-station{display:inline-block;box-sizing:border-box;width:13px;height:13px;border:3px solid #AD1457;border-radius:50%;margin:6px;vertical-align:middle;transition:none;}.ds-station-lifted{width:16px;height:16px;box-shadow:0 0 0 2px var(--ground),0 0 0 3px var(--ink);}.ds-station-receded{width:9px;height:9px;border-width:1.5px;}"
    },
    {
      "name": "Interchange Capsule",
      "kind": "custom",
      "refersTo": "interchange-capsule",
      "description": "Merged stations closer than 14 pt: an 18 pt capsule in the shared line colour, or the rail colour when categories mix, with a secondary count.",
      "html": "<span class=\"ds-interchange\">2</span>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-interchange{display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:18px;box-sizing:border-box;border:3px solid var(--rail);border-radius:9px;background:var(--ground);color:var(--ink-2);font-size:11px;font-weight:600;padding:0 6px;}.ds-interchange:hover{height:21px;box-shadow:0 0 0 2px var(--ground),0 0 0 3px var(--ink);}"
    },
    {
      "name": "Overview Line",
      "kind": "custom",
      "refersTo": "overview-line",
      "description": "60-day rail: today ring in full ink at the left, the leg to the next station in full ink, stations in line colours, next station labelled.",
      "html": "<div class=\"ds-overview\"><div class=\"ds-ov-label\">23 · ChatGPT Plus +1</div><div class=\"ds-ov-rail\"><span class=\"ds-ov-leg\"></span><span class=\"ds-ov-today\"></span><span class=\"ds-ov-st\" style=\"left:40%;border-color:#2E7D32\"></span><span class=\"ds-ov-st\" style=\"left:70%;border-color:#7B3A96\"></span></div><div class=\"ds-ov-month\">OCT</div></div>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-overview{position:relative;width:328px;height:60px;}.ds-ov-label{font-size:11px;font-weight:600;color:var(--ink);}.ds-ov-rail{position:absolute;left:10px;right:8px;top:24px;height:3px;background:var(--rail);border-radius:2px;}.ds-ov-leg{position:absolute;left:0;width:30%;top:-1px;height:5px;background:var(--ink);border-radius:3px;}.ds-ov-today{position:absolute;left:-7.5px;top:-6px;width:15px;height:15px;box-sizing:border-box;border:3px solid var(--ink);border-radius:50%;background:var(--ground);}.ds-ov-st{position:absolute;top:-5px;width:13px;height:13px;box-sizing:border-box;border:3px solid;border-radius:50%;background:var(--ground);margin-left:-6.5px;}.ds-ov-st:hover{width:16px;height:16px;top:-6.5px;}.ds-ov-month{position:absolute;top:43px;left:2px;font-size:11px;font-weight:600;letter-spacing:.6px;color:var(--ink-2);}"
    },
    {
      "name": "Strip Row",
      "kind": "card",
      "refersTo": "strip-row",
      "description": "One charge on the spine: station, 24 pt tile, name and amount tight to the margin, caption meta; lift is a 7% highlight, text never dims.",
      "html": "<div class=\"ds-strip\"><span class=\"ds-spine\"></span><button class=\"ds-row\"><span class=\"ds-tile\">S</span><span class=\"ds-row-text\"><span class=\"ds-row-top\"><b>Spotify</b><b>RUB 169</b></span><span class=\"ds-meta\"><span class=\"ds-soon\">tomorrow</span> · Sun, Oct 25 · Т-Банк •• 4242</span></span></button></div>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-strip{position:relative;width:360px;}.ds-spine{position:absolute;left:23.5px;top:0;bottom:0;width:3px;background:var(--rail);}.ds-row{all:unset;box-sizing:border-box;display:flex;gap:10px;align-items:center;width:100%;min-height:42px;padding:5px 16px 5px 44px;border-radius:6px;font-size:13px;color:var(--ink);cursor:default;}.ds-row:hover,.ds-row:focus-visible{background:rgba(29,29,31,.07);}.ds-tile{width:24px;height:24px;border-radius:6px;background:#0A6F99;color:#fff;font-weight:600;font-size:12.5px;display:grid;place-items:center;flex:none;}.ds-row-text{flex:1;display:flex;flex-direction:column;gap:2px;}.ds-row-top{display:flex;justify-content:space-between;font-weight:600;}.ds-meta{font-size:11px;color:var(--ink-2);}.ds-soon{color:var(--accent-text);font-weight:600;}"
    },
    {
      "name": "Group Head",
      "kind": "custom",
      "refersTo": "group-head",
      "description": "Tracked uppercase 11 pt semibold secondary head aligned to row text at 44 pt.",
      "html": "<div class=\"ds-group-head\">This week</div>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-group-head{font-size:11px;font-weight:600;letter-spacing:.7px;text-transform:uppercase;color:var(--ink-2);padding:12px 0 2px 44px;}"
    },
    {
      "name": "Trial Tag",
      "kind": "chip",
      "refersTo": "trial-tag",
      "description": "Outline tag carried by its text; violet line colour frames it. Ended/Inactive use the same form in secondary.",
      "html": "<span class=\"ds-tag\">Trial</span> <span class=\"ds-tag ds-tag-quiet\">Inactive</span>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-tag{display:inline-block;font-size:11px;font-weight:600;letter-spacing:.4px;text-transform:uppercase;color:#7B3A96;border:1px solid #7B3A96;border-radius:3px;padding:1px 5px;}.ds-tag-quiet{color:var(--ink-2);border-color:var(--ink-2);}"
    },
    {
      "name": "Summary Header",
      "kind": "custom",
      "refersTo": "summary-header",
      "description": "Month total with growing notes on the left; the 44 pt days figure, the only large number, on the right (accent text at 0-1).",
      "html": "<div class=\"ds-header\"><div><div class=\"ds-total\">RUB 6,381 / month</div><div class=\"ds-notes\">RUB 76,571 / year<br>CBR rate on Oct 20<br>includes 1 trial at its future price</div></div><div class=\"ds-days\"><div class=\"ds-days-n\">3</div><div class=\"ds-notes\">days until charge</div></div></div>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-header{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;width:328px;padding:12px 16px 6px;color:var(--ink);}.ds-total{font-size:17px;font-weight:600;}.ds-notes{font-size:11px;color:var(--ink-2);line-height:1.35;}.ds-days{text-align:right;}.ds-days-n{font-size:44px;font-weight:600;letter-spacing:-1px;line-height:1;}"
    },
    {
      "name": "Spending Bar (category vs payment)",
      "kind": "custom",
      "refersTo": "spending-bar-category",
      "description": "Category: station ring and 6 pt share line in its line colour. Payment method: card-shaped mark and neutral secondary-label line.",
      "html": "<div class=\"ds-bar\"><span class=\"ds-bar-ring\"></span><span class=\"ds-bar-name\">Work</span><b>RUB 2,358</b><span class=\"ds-share\">37%</span><span class=\"ds-track\"><span style=\"width:37%;background:#7B3A96\"></span></span></div><div class=\"ds-bar\"><span class=\"ds-bar-card\"></span><span class=\"ds-bar-name\">Revolut •• 0815</span><b>RUB 5,365</b><span class=\"ds-share\">84%</span><span class=\"ds-track\"><span style=\"width:84%;background:var(--ink-2)\"></span></span></div>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-bar{display:grid;grid-template-columns:13px 1fr auto 34px;column-gap:9px;align-items:center;width:328px;padding:6px 16px;font-size:13px;color:var(--ink);}.ds-bar-ring{width:13px;height:13px;box-sizing:border-box;border:3px solid #7B3A96;border-radius:50%;}.ds-bar-card{width:10px;height:7px;box-sizing:border-box;border:1.5px solid var(--ink-2);border-radius:1.5px;justify-self:center;}.ds-share{font-size:11px;color:var(--ink-2);text-align:right;}.ds-track{grid-column:2/5;margin-top:5px;height:6px;border-radius:3px;background:rgba(138,138,131,.28);overflow:hidden;}.ds-track span{display:block;height:100%;border-radius:3px;}"
    },
    {
      "name": "Panel Footer",
      "kind": "nav",
      "refersTo": "panel-footer",
      "description": "Borderless native buttons: + Add, the subscription count, Settings gear.",
      "html": "<div class=\"ds-footer\"><button class=\"ds-fbtn\">+ Add</button><span class=\"ds-count\">Total 10 · inactive 2</span><button class=\"ds-fbtn\" aria-label=\"Settings\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1\"/></svg></button></div>",
      "css": ":host{--accent:#E5352B;--accent-text:#C4271D;--rail:#8A8A83;--ink:#1D1D1F;--ink-2:#62625B;--ground:#F6F6F3;font-family:-apple-system,'SF Pro Text',system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-footer{display:flex;align-items:center;justify-content:space-between;width:328px;padding:9px 16px;border-top:1px solid rgba(0,0,0,.1);font-size:12px;font-weight:500;color:var(--ink);}.ds-fbtn{all:unset;cursor:default;display:inline-flex;align-items:center;}.ds-fbtn:hover{color:#000;}.ds-fbtn:focus-visible{outline:3px solid rgba(0,122,255,.5);border-radius:4px;}.ds-count{font-weight:400;color:var(--ink-2);}"
    },
    {
      "name": "Menu-bar Glyph and Counter",
      "kind": "custom",
      "refersTo": "menu-bar-glyph",
      "description": "18 pt renewal ring in label colour with a #E5352B centre dot, non-template; counter in accent text, semibold, at 0-1 days.",
      "html": "<span class=\"ds-mb\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M15 9a6 6 0 1 1-2.2-4.65\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M13.6 1.9v3.2h-3.2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"9\" cy=\"9\" r=\"2.6\" fill=\"#E5352B\"/></svg><span class=\"ds-mb-n ds-mb-soon\">1d</span></span>",
